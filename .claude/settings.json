{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/al-abrir.sh",
            "args": [],
            "timeout": 20,
            "statusMessage": "Leyendo estado del proyecto"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/al-cerrar.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
