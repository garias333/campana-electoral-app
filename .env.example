# Cada variable lleva "obligatoria" u "opcional". Se verificó contra el código
# (grep de process.env.* y de las desestructuraciones en config/push.js).
# "obligatoria" = sin ella la app no arranca o una función central no anda.
# "opcional"    = tiene valor por omisión en el código, o su ausencia solo
#                 apaga una función concreta.
# Los secretos van VACÍOS aquí; el valor real vive solo en el .env de cada
# instancia. Contraseñas con "#" van entre comillas dobles (dotenv corta en #).

# obligatoria — sin "production" las cookies de sesión salen sin el atributo
# Secure (app.js:129, config/equiposAutorizados.js:185)
NODE_ENV=production
# opcional — por omisión 3000 (app.js:40). Cada instancia del VPS necesita el suyo
PORT=3000
# opcional — por omisión America/Bogota (app.js:25)
TZ=

# MySQL (usar 127.0.0.1 en Hostinger, no "localhost", para evitar problemas IPv6/IPv4)
# opcional — por omisión 127.0.0.1 (config/db.js:6)
DB_HOST=127.0.0.1
# opcional — por omisión 3306 (config/db.js:7)
DB_PORT=3306
# obligatoria — sin valor por omisión (config/db.js:8)
DB_USER=
# obligatoria — sin valor por omisión (config/db.js:9)
DB_PASSWORD=
# obligatoria — la base debe existir ya: init-db.js no la crea
DB_NAME=
# opcional — base del Catálogo Territorial; por omisión territoriosdb
# (routes/catalogo.routes.js:44, routes/diaD.routes.js:161, config/testigoElectoral.js:112)
CATALOGO_DB=

# Sesión
# obligatoria — la app lanza un error y no arranca sin ella (app.js:45).
# También firma los tokens de baja y de dispositivo. Una distinta por instancia.
SESSION_SECRET=

# --- Administrador inicial (solo se usa la PRIMERA vez, al correr init-db) ---
# Si no se define ADMIN_PASSWORD, init-db genera una al azar y la imprime al
# terminar. Anótala: no se vuelve a mostrar. Nunca hay una contraseña por
# defecto conocida — antes sí la había, escrita en el propio código.
# opcional — por omisión admin@campana.local (db/init-db.js:815). Conviene fijarlo
ADMIN_EMAIL=
# opcional — por omisión una al azar (db/init-db.js:829)
# ADMIN_PASSWORD=

# --- Superadministrador (cuenta invisible, creada por init-db al INSTALAR) ---
# opcional — vacía = se usa el valor por omisión de config/superadminCorreo.js.
# Solo cuenta en una instalación nueva (cuando init-db crea al administrador): la
# contraseña inicial NO se define aquí; init-db la deja en un archivo
# .credenciales-superadmin.txt (modo 0600) que se lee con cat y se borra.
# Para una campaña que ya existe: node scripts/elevar-superadmin.js [correo]
SUPERADMIN_EMAIL=
# opcional — celular del superadministrador (para el código por SMS). init-db lo
# pone si la cuenta no tiene ninguno; por omisión 3104157434
# (config/superadminCorreo.js)
SUPERADMIN_TELEFONO=

# Nombre de la campaña / candidato.
# opcional — OJO: ningún archivo de código la lee (medido con grep); se deja
# por compatibilidad con instalaciones que ya la tienen
CAMPANA_NOMBRE=
# opcional — nombre que muestran los correos del código 2FA; por omisión
# "Estrategia | App electoral" (config/mailer.js, nombreDeLaApp)
APP_NOMBRE=

# --- Telegram (opcional) — solo para el superadministrador ---
# Si el superadministrador pide un código de ingreso, el mismo código le llega
# además por Telegram, con el nombre de la campaña (APP_NOMBRE) para saber de
# cuál viene. Sin las DOS variables queda apagado y el ingreso sigue por correo.
# Token del bot, el que entrega @BotFather (config/telegram.js)
TELEGRAM_BOT_TOKEN=
# Chat al que escribe el bot (el del superadministrador). El bot no puede
# escribirle a quien no le haya enviado antes un /start
TELEGRAM_SUPERADMIN_CHAT_ID=

# --- Licencia (servidor central de licencias) ---
# Sin estas cuatro la instalación no valida licencia ni puede actualizarse.
# obligatoria — ej. https://licencias.appestrategia.net (config/licencia.js:14)
LICENCIA_SERVIDOR_URL=
# obligatoria — secreto compartido con el servidor de licencias; también lo usa
# el actualizador (config/licencia.js:15, scripts/actualizar-automatico.js:50)
LICENCIA_API_SECRET=
# obligatoria — EXACTO al dominio registrado en el panel de licencias, sin
# https:// (config/licencia.js:16). De él sale también la huella de la máquina
LICENCIA_DOMINIO=
# obligatoria solo para ACTIVAR (la primera vez); después puede quedar vacía
# (config/licencia.js:17). La activación queda en .licencia-cache.json
LICENCIA_CLAVE=
# opcional — nombre del proceso en PM2 que reinicia el actualizador; por omisión
# lo deduce de la ruta (scripts/actualizar-automatico.js:142)
PM2_NOMBRE_PROCESO=
# opcional — solo en la máquina que PUBLICA parches, nunca en una campaña
# (scripts/registrar-parche.js:42)
PARCHES_PUBLICADOR_SECRET=

# --- Correo SMTP (recuperación de contraseña y código 2FA) ---
# En Hostinger: hPanel -> Correo electrónico -> crea la cuenta primero.
# Sin SMTP la app arranca, pero no puede enviar ninguno de esos correos.
# obligatoria (config/mailer.js:17)
SMTP_HOST=smtp.hostinger.com
# opcional — por omisión 465 (config/mailer.js:18)
SMTP_PORT=465
# opcional — por omisión true (config/mailer.js:19)
SMTP_SECURE=true
# obligatoria — la cuenta con la que se autentica (config/mailer.js:21)
SMTP_USER=
# obligatoria (config/mailer.js:22)
SMTP_PASSWORD=
# opcional — nombre que ve quien recibe (config/mailer.js:43)
SMTP_FROM_NAME=
# SMTP_FROM: solo si la dirección que ve quien recibe debe ser distinta de
# SMTP_USER. Si se omite, se usa SMTP_USER, que es lo normal — Hostinger
# rechaza enviar desde una dirección que no sea la de la cuenta autenticada.
# opcional (config/mailer.js:44)
# SMTP_FROM=

# --- Correo masivo: SendGrid ---
# opcional — la base (Configuración -> Configurar CRM) tiene prioridad sobre
# estas tres; el .env es el respaldo (config/comunicacionesConfig.js:52-54)
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=

# --- Twilio (SMS de respaldo) ---
# opcional — mismo criterio: la base primero, el .env de respaldo
# (config/comunicacionesConfig.js:55-58, lib/sms.js:346-348)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# opcional — la lee solo lib/sms.js:348; en el resto del código se usa TWILIO_SMS_FROM
TWILIO_FROM=

# --- Canal SMS (Onurix, con Twilio de respaldo) ---------------------------
# Onurix es el proveedor primario para Colombia. La cuenta es MAESTRA (una
# sola, suya) y los creditos se reparten por campana con el ledger de abajo.
#
# Onurix SOLO acepta IPv4: hay que registrar la IPv4 del VPS en
# portal.onurix.com/app/security/security o responde error 1005. lib/sms.js
# fuerza IPv4 en Node con dns.setDefaultResultOrder('ipv4first').
# Sin las variables del ledger y de Onurix, el canal SMS no funciona
# (config/sms.js:63-72 lista lo que falta); el resto de la app sigue igual.
# opcional — por omisión onurix (config/sms.js:70)
SMS_PROVIDER=onurix
# opcional — cuenta maestra (config/comunicacionesConfig.js:62-63, lib/sms.js:342)
ONURIX_CLIENT=
ONURIX_KEY=
# opcional — sin este token el webhook de Onurix rechaza todo (cerrado por
# diseño, routes/webhooks.routes.js:291)
ONURIX_WEBHOOK_TOKEN=
# Proveedor de respaldo si falla el primario. Vacio = sin respaldo.
# Con 'twilio' usa las credenciales de Configuracion -> Configurar CRM.
# opcional (config/sms.js:445)
SMS_FALLBACK_PROVIDER=
# opcional — por omisión 15000 ms (lib/sms.js:24)
SMS_TIMEOUT_MS=15000

# Ledger de creditos: vive en la base CENTRAL de licencias, no en la de la
# campana, para que el cliente no pueda editarse el saldo. La cuenta tiene
# permiso sobre TRES TABLAS —y UPDATE solo sobre la columna del consumo—;
# ver sql/usuario-sms-ledger.sql en el repositorio de origen (no viaja en la
# plantilla: es de la base de licencias).
# opcional — obligatorias solo si se usa el canal SMS (config/sms.js:94-98)
SMS_LEDGER_HOST=127.0.0.1
SMS_LEDGER_PORT=3306
SMS_LEDGER_USER=
SMS_LEDGER_PASSWORD=
SMS_LEDGER_DB=licenciasdb
# Quien es esta campana en el ledger. Si falta, se usa LICENCIA_DOMINIO.
# opcional (config/sms.js:55)
SMS_CAMPANA_ID=

# --- Notificaciones push (navegador) ---
# opcional — sin las dos llaves el push queda apagado (config/push.js:39).
# Se generan una vez por instancia: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# opcional — mailto: o https://; por omisión mailto:soporte@appestrategia.net
# (config/push.js:44)
VAPID_SUBJECT=

# --- Geocodificación ---
# opcional — sin ella no se geocodifican direcciones (config/geocoder.js:23)
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------
# Mapas
# ---------------------------------------------------------------
# opcional — sin ella el mapa funciona, pero solo con OpenStreetMap
# (routes/territorial.routes.js:2552)
#
# Token de Mapbox para el Mapa territorial (estructura y votantes) y el mapa
# del panel. SIN EL, esas pantallas solo ofrecen OpenStreetMap: los fondos
# "Mapbox Calles" y "Mapbox Satelite" NO SE OFRECEN, a proposito, porque sin
# token mostrarian teselas en blanco y un fondo roto se lee como app rota.
#
# El sintoma es mudo: el mapa funciona, nadie ve un error, y solo se nota
# porque falta el selector de fondos arriba a la derecha. Paso exactamente eso
# en las dos campanas de prueba, que nacieron sin esta linea porque este
# archivo no la traia.
#
# UNO POR CAMPANA, NUNCA COMPARTIDO. Es un token PUBLICO (empieza por pk.) y
# el servidor lo entrega al navegador en /api/territorial/mapbox-token, asi
# que el riesgo no es que se filtre: es la CUOTA. Mapbox cobra por cargas de
# mapa; con un token compartido las campanas se gastan el saldo unas a otras y
# no hay forma de saber cual consumio que.
#
# Se emite en account.mapbox.com y se RESTRINGE POR URL al dominio de esa
# campana desde el mismo panel: eso es lo que impide que alguien lo copie del
# navegador y lo use en otro sitio a costa de esta cuota.
#
# Para revisarlas todas y ponerlo sin equivocarse:
#   bash scripts/mapbox-instancias.sh
#   bash scripts/mapbox-instancias.sh --poner <usuario> pk.xxxx
MAPBOX_ACCESS_TOKEN=
