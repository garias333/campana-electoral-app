NODE_ENV=production
PORT=3000

# MySQL (usar 127.0.0.1 en Hostinger, no "localhost", para evitar problemas IPv6/IPv4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_bd
DB_PASSWORD=clave_bd
DB_NAME=campana_electoral

# Sesión
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Administrador inicial (solo se usa la PRIMERA vez, al correr init-db) ---
# Si no se define ADMIN_PASSWORD, init-db genera una al azar y la imprime al
# terminar. Anótala: no se vuelve a mostrar. Nunca hay una contraseña por
# defecto conocida — antes sí la había, escrita en el propio código.
ADMIN_EMAIL=admin@tucampana.com
# ADMIN_PASSWORD=

# Nombre de la campaña / candidato (se muestra en la interfaz)
CAMPANA_NOMBRE="Estrategia - Campaña 2027"

# --- Correo SMTP (para recuperación de contraseña) ---
# En Hostinger: hPanel -> Correo electrónico -> crea la cuenta primero
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-responder@appestrategia.net
SMTP_PASSWORD=clave_del_correo
SMTP_FROM_NAME="App Administración Electoral"
# SMTP_FROM: solo si la dirección que ve quien recibe debe ser distinta de
# SMTP_USER. Si se omite, se usa SMTP_USER, que es lo normal — Hostinger
# rechaza enviar desde una dirección que no sea la de la cuenta autenticada.
# SMTP_FROM=no-responder@appestrategia.net

# --- Canal SMS (Onurix, con Twilio de respaldo) ---------------------------
# Onurix es el proveedor primario para Colombia. La cuenta es MAESTRA (una
# sola, suya) y los creditos se reparten por campana con el ledger de abajo.
#
# Onurix SOLO acepta IPv4: hay que registrar la IPv4 del VPS en
# portal.onurix.com/app/security/security o responde error 1005. lib/sms.js
# fuerza IPv4 en Node con dns.setDefaultResultOrder('ipv4first').
SMS_PROVIDER=onurix
ONURIX_CLIENT=0000
ONURIX_KEY=clave_de_la_cuenta_maestra
# Proveedor de respaldo si falla el primario. Vacio = sin respaldo.
# Con 'twilio' usa las credenciales de Configuracion -> Configurar CRM.
SMS_FALLBACK_PROVIDER=
SMS_TIMEOUT_MS=15000

# Ledger de creditos: vive en la base CENTRAL de licencias, no en la de la
# campana, para que el cliente no pueda editarse el saldo. La cuenta tiene
# permiso sobre TRES TABLAS —y UPDATE solo sobre la columna del consumo—;
# ver sql/usuario-sms-ledger.sql.
SMS_LEDGER_HOST=127.0.0.1
SMS_LEDGER_PORT=3306
SMS_LEDGER_USER=smsledger
SMS_LEDGER_PASSWORD=clave_del_ledger
SMS_LEDGER_DB=licenciasdb
# Quien es esta campana en el ledger. Si falta, se usa LICENCIA_DOMINIO.
SMS_CAMPANA_ID=mi-campana
